# Скопируйте этот файл в .env и заполните. Файл .env в репозиторий не попадает.
# Нужен только для выгрузки в Google Таблицу (флаг --gsheet).

# Путь к JSON-ключу сервисного аккаунта Google (относительно папки проекта или полный)
GOOGLE_CREDENTIALS=credentials.json

# ID таблицы — часть ссылки между /d/ и /edit:
# https://docs.google.com/spreadsheets/d/ВОТ_ЭТО/edit
GSHEET_ID=
